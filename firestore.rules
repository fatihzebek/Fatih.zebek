rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for KKD tracking to allow quick QR scanning checks on-site
    match /kkd_inventory/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /kkd_inspections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule for all other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
